# Copy this file to .env and paste your own keys. Never commit .env.
# One Groq key powers both LLM stages (refinement and minutes). Speech-to-text runs locally and needs no key.
GROQ_API_KEY=

# Optional overrides
# WHISPER_MODEL=large-v3        (tiny, base, small, medium, large-v3)
# WHISPER_DEVICE=cpu            (cpu or cuda)
# WHISPER_COMPUTE_TYPE=int8     (int8 for cpu, float16 for cuda)
# MINUTES_MODEL=qwen/qwen3.8-27b
# WHISPER_CPU_THREADS=16        (default: your core count, max 16)
